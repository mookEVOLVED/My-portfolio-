<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>T. Calvin Jackson | Grid Portfolio</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-obsidian: #050508;
            --grid-line: rgba(255, 30, 30, 0.2);
            --primary-glow: #ff1e3c;
            --secondary-glow: #00f3ff;
            --text-main: #f0f4f8;
            --text-muted: #8a99ad;
            --panel-bg: rgba(10, 12, 20, 0.85);
            --panel-border: rgba(255, 30, 60, 0.4);
            --card-hover: rgba(255, 30, 60, 0.15);
        }

        [data-theme="blue"] {
            --grid-line: rgba(0, 243, 255, 0.2);
            --primary-glow: #00f3ff;
            --secondary-glow: #bd00ff;
            --panel-border: rgba(0, 243, 255, 0.4);
            --card-hover: rgba(0, 243, 255, 0.15);
        }

        [data-theme="dual"] {
            --grid-line: rgba(189, 0, 255, 0.2);
            --primary-glow: #bd00ff;
            --secondary-glow: #00f3ff;
            --panel-border: rgba(189, 0, 255, 0.4);
            --card-hover: rgba(189, 0, 255, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            scrollbar-width: thin;
            scrollbar-color: var(--primary-glow) var(--bg-obsidian);
        }

        body {
            background-color: var(--bg-obsidian);
            color: var(--text-main);
            font-family: 'Rajdhani', sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
        }

        h1, h2, h3, h4, .brand-name, .nav-links a, .btn {
            font-family: 'Orbitron', sans-serif;
            letter-spacing: 1.5px;
        }

        #grid-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            pointer-events: none;
        }

        /* Top Navigation */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 3rem;
            background: rgba(5, 5, 8, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--panel-border);
            z-index: 1000;
            transition: border-color 0.3s;
        }

        .brand-container {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .brand-logo {
            width: 36px;
            height: 36px;
            background: var(--primary-glow);
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 1.4rem;
            clip-path: polygon(10% 0%, 100% 0%, 90% 100%, 0% 100%);
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .brand-name {
            color: var(--text-main);
            font-size: 1.2rem;
            font-weight: 800;
            text-shadow: 0 0 10px var(--primary-glow);
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 600;
            transition: color 0.3s, text-shadow 0.3s;
            position: cuda;
        }

        .nav-links a:hover, .nav-links a.active {
            color: var(--primary-glow);
            text-shadow: 0 0 10px var(--primary-glow);
        }

        .controls-group {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .theme-btn, .audio-btn {
            background: transparent;
            border: 1px solid var(--panel-border);
            color: var(--text-main);
            padding: 6px 12px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .theme-btn:hover, .audio-btn:hover {
            background: var(--primary-glow);
            color: #000;
            box-shadow: 0 0 12px var(--primary-glow);
        }

        /* Main Container */
        main {
            max-width: 1300px;
            margin: 0 auto;
            padding: 120px 2rem 80px 2rem;
        }

        section {
            display: none;
            animation: fadeIn 0.5s ease forwards;
        }

        section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Hero / Home Section */
        .hero-grid {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 3rem;
            align-items: center;
            margin-bottom: 4rem;
        }

        .hero-badge {
            display: inline-block;
            padding: 6px 14px;
            background: rgba(255, 30, 60, 0.1);
            border: 1px solid var(--primary-glow);
            color: var(--primary-glow);
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 0 10px rgba(255, 30, 60, 0.2);
        }

        .hero h1 {
            font-size: 3.2rem;
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 1.5rem;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
        }

        .hero h1 span {
            color: var(--primary-glow);
            text-shadow: 0 0 15px var(--primary-glow);
        }

        .hero p {
            color: var(--text-muted);
            font-size: 1.15rem;
            line-height: 1.7;
            margin-bottom: 1.5rem;
        }

        .hero-visual {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            padding: 2.5rem;
            position: relative;
            box-shadow: inset 0 0 30px rgba(0,0,0,0.8), 0 0 25px var(--panel-border);
        }

        .hero-visual::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 10px; height: 10px;
            border-top: 2px solid var(--primary-glow);
            border-left: 2px solid var(--primary-glow);
        }
        .hero-visual::after {
            content: '';
            position: absolute;
            bottom: 0; right: 0; width: 10px; height: 10px;
            border-bottom: 2px solid var(--primary-glow);
            border-right: 2px solid var(--primary-glow);
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .stat-box {
            background: rgba(0,0,0,0.5);
            border: 1px solid var(--panel-border);
            padding: 1.2rem;
        }

        .stat-num {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--primary-glow);
            margin-bottom: 4px;
        }

        .stat-label {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* Section Titles */
        .section-header {
            margin-bottom: 2.5rem;
            border-bottom: 1px solid var(--panel-border);
            padding-bottom: 1rem;
        }

        .section-header h2 {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .section-header h2::before {
            content: '';
            display: inline-block;
            width: 12px;
            height: 12px;
            background: var(--primary-glow);
            box-shadow: 0 0 10px var(--primary-glow);
        }

        /* Project Cards Grid */
        .project-categories {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .cat-btn {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            color: var(--text-muted);
            padding: 8px 18px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .cat-btn.active, .cat-btn:hover {
            background: var(--primary-glow);
            color: #000;
            border-color: var(--primary-glow);
            box-shadow: 0 0 15px var(--primary-glow);
            font-weight: 700;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2rem;
        }

        .project-card {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            border-radius: 2px;
            overflow: hidden;
            transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
            cursor: pointer;
            position: relative;
        }

        .project-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-glow);
            box-shadow: 0 10px 30px var(--card-hover);
        }

        .project-img-wrap {
            height: 200px;
            background: #111;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .project-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.85;
            transition: transform 0.5s;
        }

        .project-card:hover .project-img-wrap img {
            transform: scale(1.05);
            opacity: 1;
        }

        .project-tag {
            position: absolute;
            top: 12px;
            right: 12px;
            background: rgba(0,0,0,0.8);
            border: 1px solid var(--primary-glow);
            color: var(--primary-glow);
            padding: 4px 10px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.7rem;
            text-transform: uppercase;
        }

        .project-info {
            padding: 1.5rem;
        }

        .project-info h3 {
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
            color: var(--text-main);
        }

        .project-info p {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.5;
            margin-bottom: 1.2rem;
        }

        .btn-link {
            background: transparent;
            border: 1px solid var(--panel-border);
            color: var(--primary-glow);
            padding: 8px 16px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .btn-link:hover {
            background: var(--primary-glow);
            color: #000;
            box-shadow: 0 0 12px var(--primary-glow);
        }

        /* About & Bio Content */
        .about-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 3rem;
        }

        .terminal-box {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            padding: 2rem;
            font-family: monospace;
            position: relative;
        }

        .terminal-header {
            display: flex;
            gap: 8px;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .t-dot { width: 10px; height: 10px; border-radius: 50%; }
        .t-red { background: #ff5f56; }
        .t-yellow { background: #ffbd2e; }
        .t-green { background: #27c93f; }

        .terminal-body p {
            color: #a0aec0;
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 1rem;
            font-family: 'Rajdhani', sans-serif;
        }

        .resume-card {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            padding: 2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .resume-card h3 {
            font-size: 1.4rem;
            margin-bottom: 1rem;
        }

        /* Contact Section */
        .contact-wrap {
            max-width: 700px;
            margin: 0 auto;
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            padding: 3rem;
            text-align: center;
        }

        .contact-wrap h2 {
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .contact-wrap p {
            color: var(--text-muted);
            margin-bottom: 2rem;
            font-size: 1.1rem;
        }

        .contact-btn {
            display: inline-block;
            background: var(--primary-glow);
            color: #000;
            padding: 14px 32px;
            font-family: 'Orbitron', sans-serif;
            font-weight: 800;
            text-decoration: none;
            box-shadow: 0 0 20px var(--primary-glow);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .contact-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 30px var(--primary-glow);
        }

        /* Modal / Detail View */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-content {
            background: var(--panel-bg);
            border: 1px solid var(--primary-glow);
            width: 90%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 2.5rem;
            position: relative;
            box-shadow: 0 0 40px var(--primary-glow);
            transform: scale(0.9);
            transition: transform 0.3s ease;
        }

        .modal-overlay.open .modal-content {
            transform: scale(1);
        }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: transparent;
            border: 1px solid var(--panel-border);
            color: var(--text-main);
            width: 36px;
            height: 36px;
            font-family: 'Orbitron', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .modal-close:hover {
            background: var(--primary-glow);
            color: #000;
            border-color: var(--primary-glow);
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 2rem;
            color: var(--text-muted);
            font-size: 0.85rem;
            border-top: 1px solid var(--panel-border);
            margin-top: 4rem;
            background: rgba(5,5,8,0.9);
        }

        @media(max-width: 900px) {
            .hero-grid, .about-grid { grid-template-columns: 1fr; }
            .hero h1 { font-size: 2.4rem; }
            header { padding: 1rem 1.5rem; }
            .nav-links { display: none; }
        }
    </style>
</head>
